# Runtime
APP_NAME=Rahgir
APP_ENV=development
DATABASE_URL=sqlite:///./rahgir.db
ALLOW_DEMO=true
MAX_REQUEST_BYTES=1048576
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Routing: osrm (public demo; best effort) or ors
ROUTING_PROVIDER=osrm
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_PROFILE=driving
ORS_BASE_URL=https://api.openrouteservice.org
ORS_API_KEY=

# Geocoding and POI discovery
GEOCODER_PROVIDER=nominatim
GEOCODER_BASE_URL=https://nominatim.openstreetmap.org
OVERPASS_URL=https://overpass-api.de/api/interpreter
# Identifies this app to public OSM endpoints; keep explicit user-submitted searches and rate limits.
HTTP_USER_AGENT=RahgirRoadTripPlanner/0.3.0 (+https://github.com/shashankkumar8/rahgir)
PUBLIC_PROVIDER_MIN_INTERVAL=1.05
CORRIDOR_RADIUS_M=2500
MAX_POIS=14

# Optimizer
NSGA_POPULATION=64
NSGA_GENERATIONS=60

# Admin moderation - use a long random secret outside development
ADMIN_TOKEN=


# Optional story/photo enrichment: only for OSM places explicitly tagged with wikipedia=en:...
WIKIPEDIA_ENRICHMENT=true
